# ── Resend ────────────────────────────────────────────────────────────────────
# Required for the email-gate / full report delivery feature.
# Create a free account and get your API key at https://resend.com
RESEND_API_KEY=re_your_key_here

# ── Base URL ──────────────────────────────────────────────────────────────────
# Used to build absolute URLs (sitemap, OG tags).
# In Vercel production set this to your custom domain.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────────
# Required for persistent rate limiting across serverless invocations.
# Create a free Redis database at https://upstash.com
# Falls back to in-process sliding-window when these are not set (dev only).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
