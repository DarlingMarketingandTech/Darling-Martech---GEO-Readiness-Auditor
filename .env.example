# Copy to .env.local and fill in values (see README → Environment Variables).

# ── Resend (email gate / full report) ─────────────────────────────────────────
RESEND_API_KEY=re_your_key_here

# Production: use a verified domain sender (Resend → Domains).
# RESEND_FROM=GEO Auditor <reports@yourdomain.com>

# ── Public URL (sitemap, OG, links in UI + emails) ──────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Upstash Redis (persistent rate limits on Vercel) ──────────────────────────
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
