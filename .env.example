# ── Email (Resend) ────────────────────────────────────────────────
# Required. Get your key at: https://resend.com
# Domain must be verified in Resend for production sending.
RESEND_API_KEY=re_your_key_here

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────
# Optional but recommended for production.
# Without these, rate limiting falls back to an in-process sliding window
# (resets on each cold start — fine for low traffic, not multi-instance safe).
#
# 1. Create a Redis database at https://console.upstash.com
# 2. Copy the REST URL and token from the database dashboard.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
